VITE_FIREBASE_API_KEY=your_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789
VITE_FIREBASE_APP_ID=1:123456789:web:abc123

# Get a free key at https://www.thebluealliance.com/account
# The key is stored in localStorage on the device, not in Firestore
VITE_TBA_API_KEY=

# Base URL for the AI chat backend (Firebase Cloud Functions region root).
# Production:  https://us-central1-<your-project>.cloudfunctions.net
# Emulator:    http://localhost:5001/<your-project>/us-central1
VITE_AI_API_URL=
